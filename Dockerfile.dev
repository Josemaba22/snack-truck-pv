# Dev-only image: installs deps at build time; source comes from a bind
# mount at runtime (see ../docker-compose.dev.yml) so edits hot-reload
# without rebuilding the image. Rebuild only when package*.json changes.
FROM node:22-alpine

# Run as the image's built-in "node" user (UID/GID 1000, which matches
# most Linux dev machines including this one) so files this container
# writes into the bind-mounted project (.angular/cache, etc.) stay owned
# by you on the host instead of root.
WORKDIR /app
RUN chown node:node /app
USER node

COPY --chown=node:node package*.json ./
RUN npm ci

EXPOSE 4200

CMD ["npx", "ng", "serve", "--host", "0.0.0.0", "--port", "4200"]
